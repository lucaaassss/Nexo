# ==========================================================
# NEXO SAAS - CONFIGURACIÓN DE ENTORNO (.env)
# ==========================================================

APP_NAME="Nexo"
APP_ENV="development"
APP_URL="http://localhost:8000"
APP_SECRET="nexo_dev_secret_key_98374291823791283"
APP_DEBUG=true

# Base de datos: sqlite por defecto local con cero-configuración; cambia a mysql para tu hosting o MySQL local
DB_DRIVER="sqlite"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="nexo_db"
DB_USERNAME="root"
DB_PASSWORD=""

# Inteligencia Artificial
AI_PROVIDER="mock" # cambia a openai o gemini y pon tu API key
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS="png,jpg,jpeg,gif,webp,svg,pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar,txt,csv,mp4"
