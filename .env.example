# ==========================================================
# NEXO SAAS - CONFIGURACIÓN DE ENTORNO (.env)
# ==========================================================

APP_NAME="Nexo"
APP_ENV="development" # development | production
APP_URL="http://localhost:8000"
APP_SECRET="nexo_super_secret_production_key_32_bytes_long_xyz"
APP_DEBUG=true

# Base de datos (MySQL por defecto; si DB_DRIVER=sqlite se usa SQLite)
DB_DRIVER="mysql" # mysql | sqlite
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_DATABASE="nexo_db"
DB_USERNAME="root"
DB_PASSWORD=""

# Inteligencia Artificial (OpenAI / Gemini / Claude compatible)
AI_PROVIDER="openai" # openai | gemini | mock
AI_API_KEY="sk-your-openai-or-gemini-api-key"
AI_MODEL="gpt-4o-mini"

# Correo y Notificaciones (Opcional)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="noreply@nexo-space.com"
SMTP_FROM_NAME="Nexo Platform"

# Almacenamiento
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_EXTENSIONS="png,jpg,jpeg,gif,webp,svg,pdf,doc,docx,xls,xlsx,ppt,pptx,zip,rar,txt,csv,mp4"
